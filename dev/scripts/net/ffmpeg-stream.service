[Unit]
Description=FFmpeg Camera Stream Service (self-hosted mediamtx)
Documentation=file:/root/dev/scripts/car-mode.sh
After=network-online.target
Wants=network-online.target

[Service]
# 2026-10-17：主摄音频（车端麦克风 hw:3,0）已关闭——它是图传延迟的主因。
#   音频那路的 -thread_queue_size 512 是个"延迟水库"，会把视频一起压住：
#   实测关掉后，车端「采集→编码」滞后 1.8s → 0.7s（详见 doc/图传与模式切换方案.md）。
#   恢复音频：删掉 ExecStart 里三条 "# [AUDIO-OFF 2026-10-17]" 注释，并在行尾补回续行反斜杠；
#   若想"音频和低延迟都要"，把音频的 -thread_queue_size 改成 16（不要再用 512）。
#   原始文件备份（车端）：/root/dev/backup-20261017/ffmpeg-stream.service.orig-20261017
Type=simple
# 媒体服务器地址集中在这里，改地址只改这一个文件
EnvironmentFile=-/etc/default/smartcar-media
ExecStart=/usr/bin/ffmpeg \
# 输入队列只留 ~1s（摄像头真实 ~15fps）：上行带宽不足时丢帧，而不是积压成 30s+ 延迟
  -thread_queue_size 16 \
  -f v4l2 -input_format mjpeg -video_size 640x480 -framerate 30 -i /dev/video0 \
# [AUDIO-OFF 2026-10-17]  -thread_queue_size 512
# [AUDIO-OFF 2026-10-17]  -f alsa -ac 1 -ar 48000 -i hw:3,0
  -c:v libx264 -preset veryfast -tune zerolatency -pix_fmt yuv420p \
  -crf 23 -maxrate 1200k -bufsize 300k \
  -profile:v main -level 3.0 \
  -g 30 -keyint_min 30 -sc_threshold 0 -bf 0 -refs 1 \
# [AUDIO-OFF 2026-10-17]  -c:a libopus -b:a 32k -application lowdelay -frame_duration 20
  -rtsp_transport tcp -f rtsp ${MEDIA_RTSP}/cam_car0027
Restart=always
RestartSec=3
User=root
Environment=FFREPORT=file=/var/log/ffmpeg-stream.log:level=32

[Install]
WantedBy=multi-user.target
