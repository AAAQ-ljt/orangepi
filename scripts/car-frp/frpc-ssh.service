[Unit]
Description=FRP Client Service (SSH relay to 121.40.149.155)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/root/frp/frpc -c /root/frp/frpc-ssh.ini
WorkingDirectory=/root/frp
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target